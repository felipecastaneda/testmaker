{
  "name": "testmaker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-testmaker",
    "migrate:step1": "tsx --conditions=react-server scripts/migrate-step1.ts",
    "loadtest:exam": "firebase emulators:exec --only firestore --project demo-testmaker \"tsx --conditions=react-server scripts/load-test-exam.ts\""
  },
  "dependencies": {
    "@genkit-ai/compat-oai": "^1.40.1",
    "@genkit-ai/google-genai": "^1.40.1",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.10.0",
    "genkit": "^1.40.1",
    "lucide-react": "^0.475.0",
    "next": "15.5.9",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "genkit-cli": "^1.40.1",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
