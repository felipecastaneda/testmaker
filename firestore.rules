rules_version = '2';

// All data access goes through the Next.js server (firebase-admin), which enforces
// authentication, the email allow-list and per-test ownership. Browsers never read
// or write Firestore directly, so client access is denied outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
